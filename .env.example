# Base de datos (Prisma lee este valor desde `.env`)
DATABASE_URL="file:./chincol.db"

# Dirección pública de la tienda (ej: https://chincol.cl). La usan los QR del formulario:
# si queda vacía, el QR usa la dirección desde donde abres el admin (en tu computador sería localhost).
SITE_URL=

# Contraseña del administrador (/admin). Obligatoria.
ADMIN_PASSWORD=
# Opcional: clave para firmar la sesión. Si falta, se usa la contraseña.
ADMIN_SECRET=

# Clave de la API de Claude para la sección Asistencia (https://console.anthropic.com).
# Sin ella, el resto del sistema funciona igual; solo Asistencia muestra un aviso.
ANTHROPIC_API_KEY=

# Bot de Meta (WhatsApp Business e Instagram). Webhook: https://<tu-dominio>/api/meta/webhook
# Los pasos están en /admin/asistencia → "Bot de Meta para tus clientes".
META_VERIFY_TOKEN=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_INSTAGRAM_ACCOUNT_ID=

# Número de WhatsApp de la pyme, formato internacional sin "+" ni espacios (ej: 56912345678).
# Si queda vacío, el botón abre WhatsApp para elegir el contacto.
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_INSTAGRAM=
NEXT_PUBLIC_EMAIL=
NEXT_PUBLIC_ADDRESS=
NEXT_PUBLIC_HOURS=
