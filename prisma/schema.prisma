// Base de datos de Chincol Artesanías.
// Hoy: SQLite (un archivo, sin instalar nada). Para pasar a Postgres/Supabase
// basta con cambiar `provider` y `DATABASE_URL`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  category      String
  description   String   @default("")
  price         Int // CLP
  stock         Int      @default(0)
  lowStockAlert Int      @default(2)
  madeToOrder   Boolean  @default(false)
  /// JSON: ids de colores de cuero que el cliente puede elegir
  leatherColors String   @default("[]")
  /// JSON: ids de colores de hilo
  threadColors  String   @default("[]")
  engraving     Boolean  @default(false)
  /// JSON: rutas de fotos, la primera es la principal
  images        String   @default("[]")
  measures      String?
  materialsText String?
  care          String?
  featured      Boolean  @default(false)
  published     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  recipe    RecipeItem[]
  saleItems SaleItem[]
}

/// Materiales (insumos) del taller: cueros, hilos, herrajes, acabados.
model Material {
  id        String   @id @default(cuid())
  name      String
  kind      String // cuero | hilo | herraje | acabado | otro
  unit      String // pie2 | m | u | l
  stock     Float    @default(0)
  minStock  Float    @default(0)
  unitCost  Int      @default(0) // CLP por unidad
  supplier  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipe    RecipeItem[]
  movements MaterialMovement[]
}

/// Cuánto material usa cada unidad de un producto.
model RecipeItem {
  id         String   @id @default(cuid())
  productId  String
  materialId String
  quantity   Float
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([productId, materialId])
}

/// Historial de entradas y salidas de materiales.
model MaterialMovement {
  id         String   @id @default(cuid())
  materialId String
  delta      Float
  reason     String // compra | fabricacion | venta | ajuste
  note       String?
  productId  String?
  saleId     String?
  createdAt  DateTime @default(now())
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  sale       Sale?    @relation(fields: [saleId], references: [id], onDelete: SetNull)

  @@index([materialId, createdAt])
}

model Sale {
  id            String   @id @default(cuid())
  soldAt        DateTime @default(now())
  channel       String // instagram | whatsapp | taller | feria | web | otro
  /// Nombre de la feria (solo cuando channel = feria). Los resúmenes agrupan todas como "Feria".
  fairName      String?
  payment       String // transferencia | efectivo | tarjeta
  paid          Boolean  @default(true)
  customer      String?
  note          String?
  total         Int
  discountStock Boolean  @default(true)
  /// Clienta registrada (si se eligió al registrar la venta). Sirve para sus descuentos.
  customerId    String?
  createdAt     DateTime @default(now())

  items     SaleItem[]
  movements MaterialMovement[]
  client    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([soldAt])
  @@index([customerId])
}

model SaleItem {
  id          String   @id @default(cuid())
  saleId      String
  productId   String?
  productName String
  unitPrice   Int
  quantity    Int
  /// Descuento en pesos sobre la línea (total = unitPrice × quantity − discount)
  discount    Int      @default(0)
  /// Unidades que salieron del stock de productos terminados
  fromStock   Int      @default(0)
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

/// Conversaciones de Asistencia (IA para ella: publicaciones, ferias, respuestas, descripciones).
model AssistantConversation {
  id           String   @id @default(cuid())
  task         String // publicacion | feria | respuesta | descripcion
  title        String
  /// JSON: historial completo en formato de la API de Claude (texto, herramientas y razonamiento)
  messages     String   @default("[]")
  /// JSON, solo postulaciones a ferias: [{ id, text, status: "listo" | "falta", note }]
  requirements String?
  fairName     String?
  /// Fecha de cierre tal como la dicen las bases (texto libre)
  fairDeadline String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([updatedAt])
}

/// Ajustes simples clave/valor (ej. valor de la hora para la calculadora).
model Setting {
  key   String @id
  value String
}

/// Correos suscritos al newsletter desde el pie de la tienda.
model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

/// Ferias y eventos del calendario. Fechas como "2026-10-04" (día en Chile, sin hora).
model FairEvent {
  id        String   @id @default(cuid())
  name      String
  kind      String // feria | evento
  startDate String
  endDate   String?
  place     String?
  /// Último día para postular (si la feria pide postulación)
  applyBy   String?
  status    String   @default("por-postular") // por-postular | postulada | confirmada | descartada
  /// Valor del stand o inscripción, en CLP
  cost      Int      @default(0)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startDate])
  @@index([applyBy])
}

/// Códigos de promoción que el cliente escribe en el carrito.
model PromoCode {
  id        String   @id @default(cuid())
  /// En mayúsculas y sin espacios, ej. "CHINCOL10"
  code      String   @unique
  kind      String // porcentaje | monto
  /// Porcentaje (1–90) o pesos, según `kind`
  value     Int
  /// Compra mínima para usarlo, en CLP (0 = sin mínimo)
  minTotal  Int      @default(0)
  /// Último día válido ("2026-12-31"); vacío = no vence
  expiresOn String?
  active    Boolean  @default(true)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Clientas que dejaron sus datos en /formulario (con consentimiento).
model Customer {
  id         String   @id @default(cuid())
  name       String
  /// Solo dígitos, formato internacional sin "+", ej. "56912345678"
  phone      String   @unique
  email      String?
  comuna     String?
  /// De dónde llegó: "feria:<id del evento>", "instagram", etc.
  source     String?
  newsletter Boolean  @default(false)
  consentAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  devices CustomerDevice[]
  sales   Sale[]
}

/// Cada celular o computador donde la clienta guardó sus datos (para reconocerla en el carrito).
model CustomerDevice {
  token      String   @id
  customerId String
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

/// Visitas al formulario que terminaron (guardando o no). Sin datos personales: solo el origen.
model FormVisit {
  id        String   @id @default(cuid())
  source    String?
  saved     Boolean
  createdAt DateTime @default(now())

  @@index([source])
}

/// Descuentos automáticos para clientas registradas.
model LoyaltyRule {
  id        String   @id @default(cuid())
  kind      String // antiguedad (meses desde la primera compra) | piezas (piezas compradas)
  threshold Int
  percent   Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}
